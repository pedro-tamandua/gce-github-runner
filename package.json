{
  "name": "gce-github-runner",
  "description": "GitHub Action for automatic creation and registration of a Google Compute Engine instance as a GitHub Actions self-hosted runner.",
  "license": "MIT",
  "scripts": {
    "index": "node -r dotenv/config ./src/index.js",
    "lint": "eslint ./src/*.js",
    "package": "ncc build ./src/index.js",
    "test": "jest"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@google-cloud/compute": "^4.10.0",
    "google-auth-library": "^9.15.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "dotenv": "^8.6.0",
    "eslint": "^7.32.0",
    "jest": "^30.2.0"
  }
}
